# ═══════════════════════════════════════════════════════════
# FeasiAI Frontend — Environment Variables
# Copy to .env.local and fill in values
# ═══════════════════════════════════════════════════════════

# Backend API (Express server running on AWS)
# The Next.js API routes proxy to this URL (server-side only)
SERVER_URL=https://aientitle.com

# Fallback for client-side WebSocket connections
NEXT_PUBLIC_SERVER_URL=https://aientitle.com

# Shared secret for server-to-server proxy auth
AIENTITLE_API_KEY=

# ─── Supabase (same project as original) ────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Frontend identity ──────────────────────────────────
FRONTEND_URL=https://feasiai.com
NEXT_PUBLIC_APP_URL=https://feasiai.com

# ─── Stripe (optional — for billing) ────────────────────
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
